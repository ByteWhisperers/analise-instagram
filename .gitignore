# Segredos — NUNCA versionar
config.local.json
*.session
.instaloader-session*
session-*

# Ambiente
.venv/
__pycache__/
*.pyc

# Dados baixados (pesados e de terceiros)
dados/buscas/*
dados/perfis/*
dados/analises/*
# Video gravado por ele. Material proprio, pesado, e o repositorio e publico.
dados/gravacoes/*
# Dossies de mapeamento: saida derivada, refeita a cada rodada. Segue a mesma
# regra de buscas/ e analises/ — o que sobrevive e o que voce APROVOU, e isso
# mora no banco, nao no arquivo.
dados/mapeamentos/*
!dados/buscas/.gitkeep
!dados/perfis/.gitkeep
!dados/analises/.gitkeep
!dados/gravacoes/.gitkeep
!dados/gravacoes/roteiro.exemplo.txt
!dados/mapeamentos/.gitkeep

# Saída gerada
saida/*
!saida/.gitkeep

# Modelos de transcrição baixados
modelos/

# Sessao do Instagram (equivale a senha guardada)
.sessoes/
